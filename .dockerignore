# 依赖和构建产物
node_modules/
dist/
frontend/node_modules/
frontend/dist/
backend/node_modules/
backend/dist/

# 版本控制
.git/
.github/
.gitignore

# 开发工具和环境
.vscode/
.idea/

# 系统文件
.DS_Store
Thumbs.db

# 日志文件
*.log
logs/

# 环境配置：只排除仓库外的本机覆盖层。
# ⚠️ 不可写成 `.env*`：Dockerfile 的 `COPY backend/.env.production /app/.env` 依赖该文件，
# 而 `.env*` 会把它一并排除，导致构建失败。
.env
.env.local
.env.*.local

# 文档
docs/
README.md
*.md

# 测试文件
test/
tests/
*.test.js
*.spec.js

# 临时文件
tmp/
temp/
*.tmp
*.temp
