# 统一行尾（UTF-8 / LF）

# 默认值：文本文件的换行符在库中一律规范化为 LF
* text=auto eol=lf

# 源码与脚本必须是 LF，否则 Windows 检出为 CRLF 时会出现 `bad interpreter`
*.sh  text eol=lf
*.js  text eol=lf
*.ts  text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows 批处理必须是 CRLF（LF 会导致 goto / 标签解析异常）
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资源
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.sqlite     binary
*.sqlite-journal binary
*.sqlite-wal binary
*.sqlite-shm binary
